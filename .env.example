# Copy to .env for local runs. In GitHub Actions, set these as repo Secrets instead.

# --- Instagram / Meta Graph API ---
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0

# Public HTTPS base that serves the OUTPUT_DIR folder (Instagram fetches images
# from here). In CI this is set automatically to a raw GitHub URL. For local
# publishing you must host the images somewhere public and point this at it.
PUBLIC_IMAGE_BASE_URL=

# --- Optional branding overrides ---
BRAND_NAME=Tanted Investments
BRAND_HANDLE=@tanted_investments
BRAND_WEBSITE=tantedinvestments.com
# COLOR_BG=#0B1F3A
# COLOR_ACCENT=#E8B04B
# FONT_PATH=
OUTPUT_DIR=output
